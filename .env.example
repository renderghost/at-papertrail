# Copy to .env.local for local overrides. Nothing here is secret.

# Public URL the site is served from (origin + path, trailing slash). The OAuth
# client metadata (client-metadata.json) and the base path are generated from it.
# Not needed on Vercel: production uses the project's production domain and
# previews use their own URL (see src/lib/siteUrl.ts). Set it to pin production
# to one domain, or to build for another host.
# VITE_SITE_URL=https://papertrail.renderg.host/

# Optional Google Books API key for a higher search quota. Search works without it.
# VITE_GOOGLE_BOOKS_API_KEY=
