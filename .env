# Public configuration only — this file is committed. Put secrets in .env.local.

# Public URL of the deployed site (origin + path). The OAuth client metadata
# (client-metadata.json) and the build's base path are generated from it, and
# the build fails without it. Change it if you move to a custom domain.
VITE_SITE_URL=https://renderghost.github.io/at-papertrail/

# Optional Google Books API key for a higher search quota. Search works without it.
VITE_GOOGLE_BOOKS_API_KEY=
